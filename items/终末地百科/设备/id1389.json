                    {
                      "color": "light_text_tertiary",
                      "kind": "text",
                      "text": {
                        "text": "“毒沼”MK-I的特殊改装版本，针对重防护装备单位设计，能通过射出强腐蚀性液体弹有效摧毁敌人的防御能力。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              },
              "orfMVGeXWnZ1": {
                "id": "orfMVGeXWnZ1",
                "parentId": "document-id",
                "align": "left",
                "kind": "text",
                "text": {
                  "inlineElements": [
                    {
                      "bold": true,
                      "kind": "text",
                      "text": {
                        "text": "攻击方式：发射特制酸液弹，酸液弹会在敌人附近地面爆炸并造成范围"
                      }
                    },
                    {
                      "bold": true,
                      "color": "light_function_green",
                      "kind": "text",
                      "text": {
                        "text": "自然伤害"
                      }
                    },
                    {
                      "bold": true,
                      "kind": "text",
                      "text": {
                        "text": "，同时降低范围内敌人的防御力。"
                      }
                    }
                  ],
                  "kind": "body"
                }
              }
